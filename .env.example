# --- Payments (Stripe) ---
# Leave BLANK to run the free built-in demo checkout (no real charge).
# Add your secret key to turn on real card / Apple Pay / Google Pay payments.
# Get it free at https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) while developing, live key (sk_live_...) in production.
STRIPE_SECRET_KEY=

# --- Payments (PayPal) — optional alternative to Stripe ---
# Leave BLANK to hide the PayPal button. Fill all three to enable it.
# Get free credentials at https://developer.paypal.com/dashboard/applications
# NEXT_PUBLIC_ prefix is required so the browser SDK can read the client id.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for real payments.
PAYPAL_ENV=sandbox
